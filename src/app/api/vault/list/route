import { NextResponse } from "next/server";
import { getServerSession } from "next-auth";
import { authOptions, sb } from "@/infrastructure/auth/auth-options";
import { createClient } from "@supabase/supabase-js";

export const runtime = "nodejs";

const {
  SUPABASE_URL,
  SUPABASE_SERVICE_ROLE_KEY,
  STORAGE_BUCKET = "guild-vault",
} = process.env;

if (!SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) throw new Error("Supabase server env missing");
const sb = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, { auth: { persistSession: false } });

type RoleLevel = "gm" | "officer" | "core" | "raider" | "trial";
const ROLE_ORDER: RoleLevel[] = ["trial", "raider", "core", "officer", "gm"];
function requireMinRole(role: RoleLevel, min: RoleLevel) {
  return ROLE_ORDER.indexOf(role) >= ROLE_ORDER.indexOf(min);
}

export async function GET(req: Request) {
  const session = await getServerSession(authOptions);
  if (!session) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  if (!requireMinRole(session.user.roleLevel as RoleLevel, "officer")) {
    return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  }

  const { searchParams } = new URL(req.url);
  const weekIso = searchParams.get("weekIso") || "";
  const status = searchParams.get("status") || "pending";
  const page = parseInt(searchParams.get("page") || "1", 10);
  const pageSize = Math.min(parseInt(searchParams.get("pageSize") || "50", 10), 100);
  if (!/^20\d{2}-W\d{2}$/.test(weekIso)) {
    return NextResponse.json({ error: "weekIso inválido" }, { status: 422 });
  }

  const from = (page - 1) * pageSize;
  const to = from + pageSize - 1;

  const { data, error, count } = await sb
    .from("vault_entries")
    .select("id, week_iso, files, status, created_at, user_id, profiles!inner(id,discord_id,username,role)", { count: "exact" })
    .eq("week_iso", weekIso)
    .eq("status", status)
    .order("created_at", { ascending: true })
    .range(from, to);

  if (error) {
    return NextResponse.json({ error: "DB error", detail: error.message }, { status: 500 });
  }

  // Generar signed GET por archivo
  const items = await Promise.all(
    (data || []).map(async (row: any) => {
      const files = await Promise.all(
        (row.files || []).map(async (f: any) => {
          const { data: s, error: e } = await sb.storage.from(STORAGE_BUCKET).createSignedUrl(f.path, 60 * 15);
          if (e || !s) return { path: f.path, signedUrl: null };
          return { path: f.path, signedUrl: s.signedUrl };
        })
      );

      return {
        entryId: row.id,
        user: {
          id: row.profiles.id,
          discordId: row.profiles.discord_id,
          username: row.profiles.username,
          roleLevel: row.profiles.role,
        },
        weekIso: row.week_iso,
        files,
        status: row.status,
        createdAt: row.created_at,
      };
    })
  );

  const hasMore = (from + (data?.length || 0)) < (count || 0);
  return NextResponse.json({ items, page, pageSize, hasMore }, { status: 200 });
}
